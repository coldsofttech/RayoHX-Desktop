# Copy to .env and edit. Settings are read from RAYOHX_API_* environment variables or this file.
# List values are JSON.

# Where to listen
RAYOHX_API_HOST=127.0.0.1
RAYOHX_API_PORT=8000
RAYOHX_API_LOG_LEVEL=info

# Authentication: set accepted API keys (sent in the X-API-Key header), or turn it off for local
# development. The service will not start with neither.
# RAYOHX_API_API_KEYS=["change-me"]
# RAYOHX_API_AUTH_MODE=none

# Serve /docs, /redoc and /openapi.json (off by default)
# RAYOHX_API_DOCS_ENABLED=true

# Largest request body in bytes (default 1048576)
# RAYOHX_API_MAX_BODY_BYTES=1048576

# Origins allowed by CORS (none by default)
# RAYOHX_API_CORS_ORIGINS=["http://localhost:3000"]

# Folder downloads are saved in. Clients choose file names, never folders
# (default ~/Downloads/RayoHX)
# RAYOHX_API_DOWNLOAD_DIR=/srv/rayohx/downloads

# Downloads that run at once, 1 to 16; the rest wait in the queue (default 2)
# RAYOHX_API_MAX_ACTIVE_DOWNLOADS=2

# Let requests name files on this machine (cookie files, certificates, FFmpeg, file keys).
# Leave off for a network service, because a client could make the server read its own files
# (default false)
# RAYOHX_API_ALLOW_LOCAL_PATHS=false

# SQLite file that keeps the download list, engine logs and saved defaults between restarts
# (default: the per-user app data folder, ColdSoft Technologies/RayoHX/rayohx.db)
# RAYOHX_API_DB_PATH=/srv/rayohx/rayohx.db
